{
  "name": "WhatsApp Agent — New Lead Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-lead",
      "name": "Webhook: New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "new-lead"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nconst name = body.name || body.full_name || body.firstName || 'ליד חדש';\nconst phone = body.phone || body.mobile || body.telephone || '';\nconst email = body.email || '';\nconst source = body.source || body.utm_source || 'לא ידוע';\nconst notes = body.notes || body.message || '';\nconst phoneClean = phone.replace(/[^0-9]/g, '').replace(/^0/, '972');\nreturn [{ json: { name, phone: phoneClean, email, source, notes, rawPhone: phone } }];"
      },
      "id": "parse-lead",
      "name": "Parse Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "check-phone",
              "leftValue": "={{ $json.phone.length > 9 }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "has-phone",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/api/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $json.phone }}" },
            { "name": "name", "value": "={{ $json.name }}" },
            { "name": "notes", "value": "=ליד | מקור: {{ $json.source }}{{ $json.email ? ' | ' + $json.email : '' }}" }
          ]
        },
        "options": {}
      },
      "id": "save-contact",
      "name": "Save Contact in Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agent-api-key",
          "name": "Agent API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "title", "value": "=📞 ליד חדש: {{ $('Parse Lead Data').item.json.name }} — לחזור בהקדם" },
            { "name": "notes", "value": "=טלפון: {{ $('Parse Lead Data').item.json.rawPhone }} | מקור: {{ $('Parse Lead Data').item.json.source }}" }
          ]
        },
        "options": {}
      },
      "id": "add-task",
      "name": "Add Follow-up Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 380],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agent-api-key",
          "name": "Agent API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/api/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $env.OWNER_PHONE }}" },
            { "name": "message", "value": "=🔔 *ליד חדש!*\n\n👤 *שם:* {{ $('Parse Lead Data').item.json.name }}\n📱 *טלפון:* {{ $('Parse Lead Data').item.json.rawPhone }}\n📧 *מייל:* {{ $('Parse Lead Data').item.json.email || '—' }}\n🌐 *מקור:* {{ $('Parse Lead Data').item.json.source }}\n{{ $('Parse Lead Data').item.json.notes ? '💬 *הערות:* ' + $('Parse Lead Data').item.json.notes : '' }}\n\n✅ נוסף לאנשי קשר ומשימות!" }
          ]
        },
        "options": {}
      },
      "id": "notify-owner",
      "name": "Notify Owner via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1140, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agent-api-key",
          "name": "Agent API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Lead saved and owner notified\" }",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1360, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL }}/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "title", "value": "=📞 ליד ללא טלפון: {{ $('Parse Lead Data').item.json.name }}" },
            { "name": "notes", "value": "=מייל: {{ $('Parse Lead Data').item.json.email }} | מקור: {{ $('Parse Lead Data').item.json.source }}" }
          ]
        },
        "options": {}
      },
      "id": "task-no-phone",
      "name": "Add Task (No Phone)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 520],
      "credentials": {
        "httpHeaderAuth": {
          "id": "agent-api-key",
          "name": "Agent API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Lead saved (no phone — task created)\" }",
        "options": {}
      },
      "id": "respond-no-phone",
      "name": "Respond (No Phone)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1140, 520]
    }
  ],
