# Google Gemini API Key — https://aistudio.google.com/app/apikey (FREE, no credit card)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Brave Search — 2000 free searches/month — https://api.search.brave.com/
# Without this, DuckDuckGo is used automatically (no key needed)
# BRAVE_SEARCH_API_KEY=your_brave_search_key_here

# WhatsApp Cloud API — https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string you choose — must match what you enter in the Meta webhook config
VERIFY_TOKEN=my_secret_verify_token

# ngrok — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# OpenAI Whisper — for voice message transcription (optional)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Gmail — for sending emails (optional)
# Gmail → Settings → Security → 2-Step Verification → App Passwords
# EMAIL_ADDRESS=your@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM_NAME=Your Name

# Google Calendar (optional) — run: npm run auth-google
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: for automatic Meta webhook registration
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret

# Server port (optional, defaults to 3000)
PORT=3000

# ── n8n Integration (optional) ─────────────────────────────────────────────────
# Base URL of your n8n instance's webhook endpoint
# Self-hosted: https://your-n8n-server.com/webhook
# n8n Cloud:   https://your-name.app.n8n.cloud/webhook
# N8N_WEBHOOK_URL=https://your-n8n.instance/webhook

# API key to protect the /api REST endpoints (any random string)
# Set the same value as "x-api-key" header in your n8n HTTP Request nodes
# N8N_API_KEY=change-me-to-a-random-secret

# ── Visitt Facility Management (optional) ──────────────────────────────────────
# Option A: Partner API token (Visitt dashboard → Settings → Integrations)
# VISITT_API_TOKEN=your_visitt_partner_api_token
#
# Option B: Your Visitt login credentials (browser-based — no Partner API needed)
# The system will log in automatically via Playwright and pull real-time data
# VISITT_EMAIL=you@example.com
# VISITT_PASSWORD=your_visitt_password
