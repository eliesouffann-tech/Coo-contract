# Anthropic API Key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Cloud API — https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string you choose — must match what you enter in the Meta webhook config
VERIFY_TOKEN=my_secret_verify_token

# ngrok — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Google Calendar (optional) — run: npm run auth-google
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: for automatic Meta webhook registration
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret

# Server port (optional, defaults to 3000)
PORT=3000
